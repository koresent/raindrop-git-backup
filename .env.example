# Raindrop.io Configuration

# Option A: Test token (recommended, permanent token for personal use)
# Obtain from: https://app.raindrop.io/settings/integrations -> Your App -> Create test token
RAINDROP_TOKEN=your_test_token_here

# Option B: OAuth 2.0 credentials
RAINDROP_CLIENT_ID=6af0d98918593f567f2e2e47
RAINDROP_CLIENT_SECRET=
RAINDROP_REFRESH_TOKEN=

# Collection ID to export (0 = all collections)
RAINDROP_COLLECTION_ID=0

# Git Repository Configuration

# Target repository URL (HTTPS or SSH)
GIT_REMOTE_URL=https://github.com/username/repository.git

# Git access token (masked in logs)
GIT_TOKEN=ghp_your_token_here
GIT_USERNAME=oauth2
GIT_BRANCH=main

# Commit author details
GIT_USER_NAME=Raindrop Backup Bot
GIT_USER_EMAIL=backup-bot@users.noreply.github.com
GIT_COMMIT_MESSAGE=Backup Raindrop bookmarks: {date}

# Storage and Format Settings

# Netscape Bookmark HTML format, compatible with browser import
BACKUP_FILE_NAME=bookmarks.html
DATA_DIR=/app/data

# Schedule and Runtime Settings

# Supercronic schedule expression (default: daily at 03:00)
CRON_SCHEDULE=0 3 * * *
RUN_ON_STARTUP=true
TZ=Europe/Amsterdam
